PORT=8001

# Self-hosted Ollama generate API
OLLAMA_GENERATE_URL=https://olama.duckdns.org/api/generate
OLLAMA_MODEL=qwen2.5:3b-instruct
USE_LLM_SUGGEST=true
USE_LLM_CLASSIFY=true

# Optional — Groq is disabled in favour of Ollama
GROQ_API_KEY=
GROQ_SUGGEST_MODEL=qwen/qwen3-32b
GROQ_CLASSIFY_MODEL=qwen/qwen3-32b

API_BASE_URL=https://stagingapi.londonwastemanagement.uk
